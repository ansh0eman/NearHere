{
  "version": 8,
  "name": "NearHere Night Arcade v1",
  "metadata": {
    "nearhere:theme": "Night Arcade",
    "nearhere:themeVersion": 1
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">© OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "nearhere-background",
      "type": "background",
      "paint": { "background-color": "#111516" }
    },
    {
      "id": "nearhere-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["==", ["get", "class"], "residential"]],
      "paint": { "fill-color": "#151B1B", "fill-opacity": 0.72 }
    },
    {
      "id": "nearhere-woodland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 8,
      "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["==", ["get", "class"], "wood"]],
      "paint": { "fill-color": "#1C2A23", "fill-opacity": 0.9 }
    },
    {
      "id": "nearhere-parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["match", ["get", "class"], ["park", "garden", "golf_course", "nature_reserve"], true, false]],
      "paint": { "fill-color": "#23382C", "fill-opacity": 0.94 }
    },
    {
      "id": "nearhere-water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all", ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "fill-color": "#192C35", "fill-antialias": true }
    },
    {
      "id": "nearhere-waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#31515A", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 15, 2.2] }
    },
    {
      "id": "nearhere-buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 12,
      "paint": { "fill-color": "#202828", "fill-outline-color": "#293434", "fill-antialias": true }
    },
    {
      "id": "nearhere-minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#34413E", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.45, 16, 3] }
    },
    {
      "id": "nearhere-major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#4A5A54", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 7, 0.8, 15, 4] }
    },
    {
      "id": "nearhere-motorways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#647268", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 1, 15, 5] }
    },
    {
      "id": "nearhere-suburb-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "suburb"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 10, "text-transform": "uppercase", "text-letter-spacing": 0.08 },
      "paint": { "text-color": "#A6B5AA", "text-halo-color": "#111516", "text-halo-width": 1.2 }
    },
    {
      "id": "nearhere-city-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "city"], [">", ["get", "rank"], 3]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 12, "text-transform": "uppercase", "text-letter-spacing": 0.1 },
      "paint": { "text-color": "#E7EDE5", "text-halo-color": "#111516", "text-halo-width": 1.6 }
    },
    {
      "id": "nearhere-water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": { "symbol-placement": "line", "symbol-spacing": 500, "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 10 },
      "paint": { "text-color": "#85A9AD", "text-halo-color": "#192C35", "text-halo-width": 1 }
    }
  ]
}
