# Public client configuration from the Supabase project Connect dialog.
# The publishable key is designed to be used by clients; never place a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Keep Nominatim only for development. Set google_places after the Edge Function
# is deployed and GOOGLE_PLACES_API_KEY is configured as a Supabase secret.
EXPO_PUBLIC_PLACE_SEARCH_PROVIDER=nominatim
